  "components": [
    {
      "name": "Primary Button (on charcoal)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action on a charcoal ground: white with charcoal ink.",
      "html": "<div class=\"ds-ground\"><button class=\"ds-btn-p\">Nominate a trial area <svg class=\"ds-go\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"13,6 19,12 13,18\"/></svg></button></div>",
      "css": ".ds-ground{background:#26282B;padding:24px}.ds-btn-p{display:inline-flex;align-items:center;gap:.55em;font:600 1rem/1 Inter,system-ui,sans-serif;padding:.85em 1.2em;border:1px solid transparent;border-radius:2px;background:#FFFFFF;color:#26282B;cursor:pointer;transition:background-color 200ms cubic-bezier(0.22,1,0.36,1),transform 120ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-p:hover{background:#C4CAD0}.ds-btn-p:active{transform:translateY(1px)}.ds-btn-p:focus-visible{outline:2px solid #FFFFFF;outline-offset:3px}.ds-go{transition:transform 200ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-p:hover .ds-go{transform:translateX(3px)}"
    },
    {
      "name": "Ghost Button (on charcoal)",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action on charcoal: mid-grey edge (5.6:1), white on hover.",
      "html": "<div class=\"ds-ground-g\"><button class=\"ds-btn-g\">Book a yard walk</button></div>",
      "css": ".ds-ground-g{background:#26282B;padding:24px}.ds-btn-g{font:600 1rem/1 Inter,system-ui,sans-serif;padding:.85em 1.2em;border:1px solid #99A1A7;border-radius:2px;background:transparent;color:#FFFFFF;cursor:pointer;transition:border-color 200ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-g:hover{border-color:#FFFFFF}.ds-btn-g:focus-visible{outline:2px solid #FFFFFF;outline-offset:3px}"
    },
    {
      "name": "Primary Button (on light)",
      "kind": "button",
      "refersTo": "button-primary-on-light",
      "description": "The same action inverted for paper and white grounds.",
      "html": "<button class=\"ds-btn-pl\">Nominate a trial area</button>",
      "css": ".ds-btn-pl{font:600 1rem/1 Inter,system-ui,sans-serif;padding:.85em 1.2em;border:1px solid transparent;border-radius:2px;background:#26282B;color:#FFFFFF;cursor:pointer;transition:background-color 200ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-pl:hover{background:#2F3233}.ds-btn-pl:focus-visible{outline:2px solid #26282B;outline-offset:3px}"
    },
    {
