      "refersTo": "button-ghost-on-light",
      "description": "Secondary action on light; fills charcoal on hover.",
      "html": "<button class=\"ds-btn-gl\">Book a yard walk</button>",
      "css": ".ds-btn-gl{font:600 1rem/1 Inter,system-ui,sans-serif;padding:.85em 1.2em;border:1px solid #26282B;border-radius:2px;background:transparent;color:#26282B;cursor:pointer;transition:background-color 200ms cubic-bezier(0.22,1,0.36,1),color 200ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-gl:hover{background:#26282B;color:#FFFFFF}.ds-btn-gl:focus-visible{outline:2px solid #26282B;outline-offset:3px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Label, input and hint: slate edge, charcoal focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-l\">Yard area (m²)</span><input class=\"ds-input\" placeholder=\"e.g. 2400\"><span class=\"ds-field-h\">Approximate is fine. We measure it on the yard walk.</span></label>",
