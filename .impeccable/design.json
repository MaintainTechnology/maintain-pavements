      "css": ".ds-nav{display:flex;align-items:center;gap:24px;height:64px;padding:0 24px;background:#26282B;border-bottom:1px solid rgba(255,255,255,.12);font-family:Inter,system-ui,sans-serif}.ds-nav-logo{display:block;height:28px;width:auto;margin-right:auto;color:#FFFFFF;flex:none}.ds-nav a{color:rgba(255,255,255,.72);text-decoration:none;font-size:.875rem;font-weight:500;padding:8px 0;border-bottom:2px solid transparent;transition:color 200ms cubic-bezier(0.22,1,0.36,1),border-color 200ms cubic-bezier(0.22,1,0.36,1)}.ds-nav a:hover{color:#FFFFFF;border-bottom-color:currentColor}.ds-nav a:focus-visible{outline:2px solid #FFFFFF;outline-offset:3px}"
