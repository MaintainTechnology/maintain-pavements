[
  {
    "fromSeconds": 0,
    "toSeconds": 2.3,
    "text": "Maintain Pavements introduces SuperBase:"
  },
  {
    "fromSeconds": 2.78,
    "toSeconds": 4.44,
    "text": "a five-step process for turning"
  },
  {
    "fromSeconds": 4.44,
    "toSeconds": 7.38,
    "text": "suitable existing yard base into bound hardstand."
  },
  {
    "fromSeconds": 8.14,
    "toSeconds": 8.98,
    "text": "First, prepare."
  },
  {
    "fromSeconds": 9.56,
    "toSeconds": 11.76,
    "text": "Remove loose material and scarify"
  },
  {
    "fromSeconds": 11.76,
    "toSeconds": 14.04,
    "text": "the base to about 75 millimetres."
  },
  {
    "fromSeconds": 15.02,
    "toSeconds": 16.42,
    "text": "Second, dose and mix."
  },
  {
    "fromSeconds": 17.24,
    "toSeconds": 18.44,
    "text": "Add SuperBase and water"
  },
  {
    "fromSeconds": 18.44,
    "toSeconds": 19.7,
    "text": "at the designed ratio,"
  },
  {
    "fromSeconds": 19.96,
    "toSeconds": 21.16,
    "text": "mixing through the full depth."
  },
  {
    "fromSeconds": 22.35,
    "toSeconds": 23.6,
    "text": "Third, grade to level."
  },
  {
    "fromSeconds": 24.34,
    "toSeconds": 26.42,
    "text": "Trim the workable base to the designed level"
  },
  {
    "fromSeconds": 26.42,
    "toSeconds": 27.8,
    "text": "and crossfall for drainage."
  },
  {
    "fromSeconds": 29.18,
    "toSeconds": 30.98,
    "text": "Fourth, roll and compact."
  },
  {
    "fromSeconds": 31.66,
    "toSeconds": 34.02,
    "text": "Use wet rolling, then check density"
  },
  {
    "fromSeconds": 34.02,
    "toSeconds": 35.44,
    "text": "against the dosage design."
  },
  {
    "fromSeconds": 36.2,
    "toSeconds": 38.1,
    "text": "Fifth, cure and return to service."
  },
  {
    "fromSeconds": 38.74,
    "toSeconds": 40.56,
    "text": "Timing varies with base material,"
  },
  {
    "fromSeconds": 40.88,
    "toSeconds": 42.04,
    "text": "climate and duty."
  }
]
