{
  "name": "video-studio",
  "version": "1.0.0",
  "description": "Reusable Maintain Pavements SuperBase promo studio",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/google-fonts": "4.0.527",
    "@remotion/tailwind-v4": "4.0.527",
    "@remotion/transitions": "4.0.527",
    "@remotion/zod-types": "4.0.527",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "normalise": "node scripts/normalise-footage.mjs",
    "veo:plan": "node scripts/generate-veo.mjs",
    "veo:generate": "node scripts/generate-veo.mjs --generate",
    "veo:status": "node scripts/generate-veo.mjs --status",
    "render:test": "remotion render SuperBasePromo out/test-promo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "render:promo60": "remotion render SuperBasePromo out/promo60.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:veo": "node scripts/verify-veo-safety.mjs",
    "normalise:complete": "node scripts/prepare-complete-media.mjs",
    "levelling:status": "node scripts/generate-levelling.mjs --status",
    "music:status": "node scripts/generate-superbase-music.mjs --status",
    "preview:complete": "node scripts/render-complete.mjs --stills",
    "render:complete": "node scripts/render-complete.mjs",
    "verify:complete": "node scripts/verify-complete.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
